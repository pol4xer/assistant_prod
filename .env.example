# Local portfolio demo: no Google or OpenAI account is required.
APP_NAME='Scheduling Assistant'
APP_ENV=demo
APP_DEMO_MODE=true
APP_HOST=127.0.0.1
APP_PORT=8000
STATE_DB_PATH=./var/assistant.db
APP_SECRETS_KEY_PATH=./var/assistant.key
LOG_DIR=./var/log
LOG_LEVEL=INFO
AUTOMATION_POLLING_ENABLED=false

ASSISTANT_NAME=Marlow
ASSISTANT_EMAIL=assistant@example.com
OWNER_NAME='Alex Morgan'
OWNER_EMAIL=owner@example.com
DEFAULT_TIMEZONE=UTC
DEFAULT_DURATION_MINUTES=45
MEETING_BUFFER_MINUTES=15
MIN_NOTICE_HOURS=2
CONFIRMATION_LEAD_HOURS=24
ONLINE_PROVIDER=google_meet

# Optional live integrations are documented separately and disabled in demo mode.
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
